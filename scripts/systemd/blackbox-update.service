# 서버 자동 갱신(scripts/ec2-update.sh). blackbox-update.timer가 부른다. 기록: journalctl -u blackbox-update
[Unit]
Description=Blackbox server update (config and images)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ec2-user
# 파일의 실행 권한에 기대지 않는다(이 저장소는 git이 실행 권한을 기록하지 않는 PC에서도 커밋된다)
ExecStart=/bin/bash /home/ec2-user/blackbox/scripts/ec2-update.sh
TimeoutStartSec=20min
