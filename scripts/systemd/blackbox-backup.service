# 서버 백업을 S3로 보낸다(scripts/ec2-backup-s3.sh). blackbox-backup.timer가 부른다. 기록: journalctl -u blackbox-backup
[Unit]
Description=Blackbox backup to S3 (database dump and uploads)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ec2-user
# 파일의 실행 권한에 기대지 않는다(blackbox-update.service와 같다)
ExecStart=/bin/bash /home/ec2-user/blackbox/scripts/ec2-backup-s3.sh
TimeoutStartSec=30min
