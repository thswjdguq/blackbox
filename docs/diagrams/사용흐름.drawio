0;resizable=1;" vertex="1" parent="1"><mxGeometry x="547.0" y="305.5" width="107.2" height="17.0" as="geometry" /></mxCell><mxCell id="78" value="" style="rounded=0;fillColor=#fff;strokeColor=#111827;strokeWidth=1.1;html=1;fontFamily=Malgun Gothic;whiteSpace=nowrap;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="668.16" y="304" width="36" height="20" as="geometry" /></mxCell><mxCell id="79" value="" style="edgeStyle=none;rounded=0;html=1;startArrow=none;endArrow=none;strokeColor=#111827;strokeWidth=1;exitX=0.2778;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;" edge="1" parent="1" source="78"><mxGeometry relative="1" as="geometry"><mxPoint x="678.16" y="304" as="sourcePoint" /><mxPoint x="678.16" y="324" as="targetPoint" /></mxGeometry></mxCell><mxCell id="80" value="레인: 활동하는 역할" style="text;html=1;fontFamily=Malgun Gothic;whiteSpace=nowrap;fontColor=#4B5563;fontSize=12;align=left;verticalAlign=middle;spacing=0;resizable=1;" vertex="1" parent="1"><mxGeometry x="712.2" y="305.5" width="113.9" height="17.0" as="geometry" /></mxCell><mxCell id="81" value="AI 계획 제안은 선택이다. 제출물, 요구사항, 업무를 직접 등록해도 된다." style="text;html=1;fontFamily=Malgun Gothic;whiteSpace=nowrap;fontColor=#4B5563;fontSize=12;align=left;verticalAlign=middle;spacing=0;resizable=1;" vertex="1" parent="1"><mxGeometry x="4.0" y="331.5" width="400.7" height="17.0" as="geometry" /></mxCell><mxCell id="82" value="업무 완료 확인(담당자와 요청자가 아닌 팀원)은 별도 흐름이며, 검토와 확정의 조건이 아니다." style="text;html=1;fontFamily=Malgun Gothic;whiteSpace=nowrap;fontColor=#4B5563;fontSize=12;align=left;verticalAlign=middle;spacing=0;resizable=1;" vertex="1" parent="1"><mxGeometry x="4.0" y="348.5" width="514.5" height="17.0" as="geometry" /></mxCell><mxCell id="83" value="요구사항 충족 확인은 검토와 별개로 언제든 할 수 있다. 확정 조건: 필수 요구사항 충족, 최신 회차 승인, 미해결 피드백 0건." style="text;html=1;fontFamily=Malgun Gothic;whiteSpace=nowrap;fontColor=#4B5563;fontSize=12;align=left;verticalAlign=middle;spacing=0;resizable=1;" vertex="1" parent="1"><mxGeometry x="4.0" y="365.5" width="676.7" height="17.0" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>