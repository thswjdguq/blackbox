# ─── Database ────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/blackbox_db
SPRING_DATASOURCE_USERNAME=blackbox
SPRING_DATASOURCE_PASSWORD=change_me_in_production

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=change_me_a_long_random_string_at_least_32_chars
JWT_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─── CORS ─────────────────────────────────────────────────────
# 로컬: 비워두면 * (모든 origin 허용)
# 배포: https://teamblackbox.com
APP_CORS_ORIGINS=

# ─── Google OAuth / Calendar API ──────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost/api/auth/google/callback

# ─── GitHub App ───────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ─── AI API (Claude 우선, 없으면 OpenAI 사용) ─────────────────
CLAUDE_API_KEY=
OPENAI_API_KEY=

# ─── 공공데이터포털 학교·학과 API (향후 연동용) ──────────────
# 발급받은 인증키는 실제 .env에만 입력하고 이 예시 파일에는 넣지 마세요.
# 현재 학교·학과 목록은 공식 데이터 파일을 사용합니다.
# 아래 변수는 예약 항목이며, 키 입력만으로 API 조회·자동 갱신이 활성화되지 않습니다.
# 실제 API 연동 시 서비스별 인증키 형식과 서버 환경변수 전달 설정을 확인해야 합니다.
PUBLIC_DATA_API_KEY=

# ─── Notion 연동 ──────────────────────────────────────────────
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=
NOTION_CALENDAR_DB_ID=

# ─── Discord 알림 ─────────────────────────────────────────────
# Discord 채널 → 설정 → 연동 → 웹후크 → 웹후크 URL 복사
DISCORD_WEBHOOK_URL=
