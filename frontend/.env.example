# ─── API ──────────────────────────────────────────────────────
# 화면은 항상 /api 로 요청한다.
# 로컬 개발(npm run dev): next.config.mjs 가 /api/* 를 이 주소로 넘긴다. 비우면 API 호출이 모두 실패한다
# Docker: nginx 가 /api 를 처리하므로 설정하지 않는다
NEXT_DEV_BACKEND=http://localhost:8080

# ─── Google OAuth (프로필 설정 > 캘린더 연동용) ───────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
