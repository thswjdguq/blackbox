    "title": "fix(frontend): [C-34] 파일 금고 내려받기가 로그인 갱신을 거치게",
    "user": {
      "login": "thswjdgy",
      "id": 231241221,
      "node_id": "U_kgDODch2BQ",
      "avatar_url": "https://avatars.githubusercontent.com/u/231241221?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/thswjdgy",
      "html_url": "https://github.com/thswjdgy",
      "followers_url": "https://api.github.com/users/thswjdgy/followers",
      "following_url": "https://api.github.com/users/thswjdgy/following{/other_user}",
      "gists_url": "https://api.github.com/users/thswjdgy/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/thswjdgy/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/thswjdgy/subscriptions",
      "organizations_url": "https://api.github.com/users/thswjdgy/orgs",
      "repos_url": "https://api.github.com/users/thswjdgy/repos",
      "events_url": "https://api.github.com/users/thswjdgy/events{/privacy}",
      "received_events_url": "https://api.github.com/users/thswjdgy/received_events",
      "type": "User",
