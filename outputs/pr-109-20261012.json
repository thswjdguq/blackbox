      "gists_url": "https://api.github.com/users/thswjdgy/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/thswjdgy/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/thswjdgy/subscriptions",
