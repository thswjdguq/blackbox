# ─── Database ────────────────────────────────────────────────
DB_NAME=blackbox_db
DB_USER=blackbox
DB_PASSWORD=change_me_in_production

# ─── Spring Boot DB 연결 ──────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/blackbox_db
SPRING_DATASOURCE_USERNAME=blackbox
SPRING_DATASOURCE_PASSWORD=change_me_in_production

# ─── JWT ─────────────────────────────────────────────────────
# 최소 32자 이상의 랜덤 문자열
JWT_SECRET=change_me_a_long_random_string_at_least_32_chars

# ─── CORS ─────────────────────────────────────────────────────
# 로컬: 비워두면 application-local.yml 기본값 * 적용
# 배포: 실제 도메인 입력 (예: https://teamblackbox.com)
APP_CORS_ORIGINS=

# ─── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
# 10분 전 알림 URL 생성용 (비우면 비활성, 예: https://yourdomain.com)
FRONTEND_BASE_URL=

# ─── 확장 1: GitHub App ────────────────────────────────────────
# 비워두면 해당 기능 비활성화
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ─── 확장 2: Google OAuth / Calendar API ──────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth 콜백 URI (비우면 http://localhost/api/auth/google/callback 기본값)
GOOGLE_REDIRECT_URI=

# ─── AI API 키 ────────────────────────────────────────────────
# 회의록 요약·할 일 추출: 둘 중 하나만 있어도 됨, Claude 우선
CLAUDE_API_KEY=
OPENAI_API_KEY=
# OpenAI 호환 게이트웨이(예: 학교가 준 LLM API)를 쓸 때의 주소와 모델. 키는 위의 OPENAI_API_KEY에 적는다.
# 회의록 요약과 AI 에이전트(SPRING_AI_MODEL_CHAT=openai)가 함께 쓴다. 주소에는 /v1을 붙이지 않는다. docs/deploy-aws.md 10장
# 회의록 요약을 이쪽으로 보내려면 CLAUDE_API_KEY를 비운다(값이 있으면 Claude가 먼저 쓰인다)
# LLM_BASE_URL=
# LLM_MODEL=bedrock-haiku
# AI 에이전트(K-30)를 Gemini로 쓸 때 필요하다
GEMINI_API_KEY=

# ─── 공공데이터포털 학교·학과 API (향후 연동용) ──────────────
# 발급받은 인증키는 실제 .env에만 입력하고 이 예시 파일에는 넣지 마세요.
# 현재 학교·학과 목록은 공식 데이터 파일을 사용합니다.
# 아래 변수는 예약 항목이며, 키 입력만으로 API 조회·자동 갱신이 활성화되지 않습니다.
# 실제 API 연동 시 서비스별 인증키 형식과 서버 환경변수 전달 설정을 확인해야 합니다.
PUBLIC_DATA_API_KEY=

# ─── Spring AI 설정 (AI 에이전트, K-30) ──────────────────────
# 모델 공급자. none이면 에이전트가 꺼지고 나머지 기능은 그대로 동작한다
#   none | google-genai (Gemini) | bedrock-converse (AWS Bedrock) | openai (OpenAI 호환 API. OPENAI_API_KEY, LLM_BASE_URL, LLM_MODEL)
# google-genai를 고르고 GEMINI_API_KEY를 비워 두면 서버가 뜨지 않는다. openai와 OPENAI_API_KEY도 같다
SPRING_AI_MODEL_CHAT=none
# Gemini 모델 이름. 무료 등급의 하루 한도는 Flash-Lite 500번, Flash 20번이다. 실행 한 번에 2~3번을 쓴다
GEMINI_MODEL=gemini-3.5-flash-lite

# ─── Notion 연동 ──────────────────────────────────────────────
# Notion Integration Token (https://www.notion.so/my-integrations)
NOTION_API_KEY=
# 회의록을 내보낼 Notion 상위 페이지 ID (URL 마지막 32자리)
NOTION_PARENT_PAGE_ID=
# 회의 캘린더 동기화용 Notion DB ID (선택)
NOTION_CALENDAR_DB_ID=

# ─── Discord 알림 ─────────────────────────────────────────────
# Discord 채널 → 설정 → 연동 → 웹후크 → 웹후크 URL 복사
DISCORD_WEBHOOK_URL=
